    "@types/node": "^20.14.9",
    "@types/request-ip": "^0.0.41",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
